# Copy to api/.env. Never commit the real .env.

# Base Sepolia RPC (defaults to https://sepolia.base.org if empty)
RPC_URL=https://sepolia.base.org

# The AI agent's key (0x-prefixed). Only used by scripts/pay-and-fetch.ts to call vault.pay().
# Must match AGENT_ADDRESS in contracts/.env. Throwaway testnet key only.
AGENT_PRIVATE_KEY=

# API port
PORT=4021
