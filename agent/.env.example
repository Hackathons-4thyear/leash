# Copy to agent/.env. Never commit the real .env.

# LLM for --mode llm: "anthropic" or "openai" (any OpenAI-compatible endpoint).
# Leave empty to run the scripted (no-LLM) agent.
LLM_PROVIDER=anthropic

# Anthropic Messages API
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# OpenAI-compatible chat completions with tool calling (OpenAI, Groq, OpenRouter, ...)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_MODEL=llama-3.3-70b-versatile

# Base Sepolia RPC (defaults to https://sepolia.base.org if empty)
RPC_URL=https://sepolia.base.org

# The agent's key (0x-prefixed). Must be the vault's `agent` (same key as api/.env).
# Throwaway testnet key only.
AGENT_PRIVATE_KEY=

# The Leash demo API (npm run api)
API_URL=http://localhost:4021

# Agent HTTP server for the dashboard (npm run agent:server)
PORT=4022

# Dashboard origin(s) allowed by CORS, comma-separated
WEB_ORIGIN=http://localhost:3000
