{
  "name": "leash",
  "private": true,
  "workspaces": [
    "shared",
    "api",
    "agent",
    "web"
  ],
  "scripts": {
    "sync": "node shared/scripts/sync.mjs",
    "api": "npm run dev -w @leash/api",
    "agent": "npm run start -w @leash/agent --",
    "agent:server": "npm run server -w @leash/agent",
    "web": "npm run dev -w @leash/web",
    "web:build": "npm run build -w @leash/web"
  },
  "engines": {
    "node": ">=20"
  }
}
