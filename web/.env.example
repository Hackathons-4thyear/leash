# All optional. Copy to web/.env.local to override.

# Base Sepolia RPC used for every read (defaults to the public RPC in shared/deployments).
# The public RPC limits eth_getLogs to 1,000 blocks; the dashboard chunks requests accordingly.
NEXT_PUBLIC_RPC_URL=

# Agent control server (npm run agent:server).
NEXT_PUBLIC_AGENT_URL=http://localhost:4022

# Demo video linked from the agent console when the agent server is unreachable off localhost.
# Leave empty to hide the link.
NEXT_PUBLIC_DEMO_VIDEO_URL=

# Public URL of the deployed site, for absolute Open Graph image links.
# Optional on Vercel (Next uses the deployment URL when unset).
NEXT_PUBLIC_SITE_URL=
